# Copy to .env.local for local development. Never commit real values.

# FACTS SIS connector. Off by default: the app uses sample children.
# Turn on only when the portal API (EXPO_PUBLIC_API_URL) serves /api/sis/children.
EXPO_PUBLIC_FACTS_ENABLED=false
EXPO_PUBLIC_API_URL=

# Server only (server/sis/facts.ts). Never prefix these with EXPO_PUBLIC_.
FACTS_API_BASE_URL=
FACTS_SUBSCRIPTION_KEY=
